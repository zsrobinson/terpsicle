// `wrangler dev` config for the seat-alert e2e harness (worker.ts). Local
// bindings only: never deployed, never touches Cloudflare.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "terpsicle-alerts-e2e",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "terpsicle-e2e" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terpsicle-e2e",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ]
}
