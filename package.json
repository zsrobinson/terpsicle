{
  "name": "terpsicle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:local && vite dev --port 3000",
    "dev:mock": "pnpm db:local && vite dev --mode mock --port 3000",
    "db:local": "wrangler d1 migrations apply terpsicle --local",
    "build": "vite build",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "preview": "vite preview",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "typecheck": "tsc -b",
    "lint": "biome check . && tsx scripts/check-imports.ts && tsx scripts/check-term-ids.ts && wrangler types --check",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project core --coverage",
    "test:unit": "pnpm test:coverage && vitest run --project \"!core\"",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:port": "tsx scripts/e2e-checkout.ts",
    "deploy": "pnpm build && wrangler d1 migrations apply terpsicle --remote && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "comlink": "^4.4.2",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "minisearch": "^7.2.0",
    "pmtiles": "^4.5.0",
    "posthog-js": "^1.434.13",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.60.1",
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "~4.1.11",
    "aws4fetch": "^1.0.20",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "~4.1.11",
    "wrangler": "^4.140.0"
  }
}
