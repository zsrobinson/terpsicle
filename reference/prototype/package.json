{
  "name": "terpsicle-reference-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/to-artifact.mjs",
    "dev:review": "vite --open /review.html",
    "build:review": "vite build --config vite.review.config.ts && node scripts/to-artifact.mjs dist-review/review.html dist-review/artifact.html",
    "dev:final": "vite --open /final.html",
    "build:final": "vite build --config vite.final.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}