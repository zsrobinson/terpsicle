{
  // Browser: the SPA and everything it imports.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/app",
    "src/features",
    "src/state",
    "src/components",
    "src/routes",
    "src/worker",
    "src/core",
    "src/fixtures",
    // The browser's typed API client. It imports only ~/core and zod (Biome
    // enforces it), so it typechecks in both this program and the Worker's.
    "src/server/fns",
    "src/router.tsx",
    "src/routeTree.gen.ts"
  ]
}
