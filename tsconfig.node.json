{
  // Node: configs, pipeline scripts, e2e specs, and ingest (it runs in Node
  // scripts as well as the Worker).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/node.tsbuildinfo",
    // DOM for Playwright's page.evaluate callbacks.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "scripts",
    "e2e",
    "src/ingest",
    "src/core",
    "src/fixtures",
    // Pure server modules that scripts reuse (the summary prompt trial, the
    // test email send, the moderation eval). They use only fetch and zod, so Node types suffice.
    "src/server/summaries/prompt.ts",
    "src/server/summaries/planetterp-api.ts",
    "src/server/alerts/email.ts",
    // The marks and the token reader (scripts/build-icons.ts).
    "src/app/brand/marks.ts",
    "src/app/brand/css-tokens.ts",
    // The hero's geometry and the page's link-preview facts
    // (scripts/build-og-image.ts).
    "src/features/marketing/tangle.ts",
    "src/features/marketing/meta.ts",
    // The moderation pipeline and its eval set (scripts/moderation-eval.ts).
    "src/server/moderation/classify.ts",
    "src/server/moderation/models.ts",
    "src/server/moderation/eval/cases.ts"
  ],
  // The seat-alert e2e harness is a Worker: tsconfig.worker.json checks it.
  "exclude": ["e2e/alerts-harness"]
}
