{
  // Cloudflare Worker: the entry, crons, server code. Runtime types and the
  // Env bindings come from worker-configuration.d.ts (`pnpm cf-typegen`).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/worker.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/server.ts",
    "src/server",
    "src/jobs",
    "src/ingest",
    "src/core",
    "src/fixtures",
    // The seat-alert e2e harness (a local-only Worker for e2e/seat-alerts.spec.ts).
    "e2e/alerts-harness/worker.ts"
  ],
  // Ingest tests run in Node (the `ingest` Vitest project) and read saved
  // pages with node:fs; the node program checks them.
  "exclude": ["src/ingest/**/*.test.ts"]
}
