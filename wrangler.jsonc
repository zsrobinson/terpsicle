// The one deployable: SPA assets, /data/* from R2, the PostHog proxy, server
// functions and every cron job. See docs/BUILD.md §2.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terpsicle",
  "main": "src/server.ts",
  // Newest date the pinned workerd supports; bump it together with wrangler.
  "compatibility_date": "2026-09-23",
  // TanStack Start's request handler uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Workers Cache, in front of this Worker: it keeps what's marked public
  // (the public Reviews pages, sitemaps, /data files) by Cache-Control,
  // stale-while-revalidate included. Keys include the Worker version, so a
  // deploy never serves a page naming the last deploy's scripts. Pages
  // default to no-cache; see src/server/pages/shared-pages.ts.
  "cache": { "enabled": true },

  // The Cloudflare Vite plugin fills in the assets directory at build time.
  // Asset files are served before the Worker runs, so /data/* and /ingest/*
  // (never files in the build output) always reach the Worker.
  "assets": { "binding": "ASSETS" },

  // Production lives on the custom domains only; www 301s to the apex in
  // src/server.ts.
  "workers_dev": false,
  // PR previews (`wrangler preview`) get noindexed workers.dev URLs.
  "preview_urls": true,
  "routes": [
    { "pattern": "terpsicle.com", "custom_domain": true },
    { "pattern": "www.terpsicle.com", "custom_domain": true }
  ],

  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "terpsicle-data" },
    // Feedback screenshots (docs/FEEDBACK.md), shown to the admin only. It
    // also held profile pictures under avatars/ until 2026-09-28; the daily
    // job deletes what's left (src/server/auth/legacy-pictures.ts).
    { "binding": "USER_CONTENT", "bucket_name": "terpsicle-user-content" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terpsicle",
      "database_id": "7348fc06-5c8e-44d3-b357-4f53cc30094e",
      "migrations_dir": "migrations"
    }
  ],
  // Terpsicle Chat: one CourseChat object per course per term, with its own
  // SQLite (docs/V2.md §8.4, §13). Class changes can't ship as gradual
  // deployments; we don't use them.
  "durable_objects": {
    "bindings": [{ "name": "COURSE_CHAT", "class_name": "CourseChat" }]
  },
  "migrations": [
    { "tag": "v1-course-chat", "new_sqlite_classes": ["CourseChat"] }
  ],
  "vars": {
    // Public PostHog project token (the same one the client ships). Server
    // telemetry is off wherever it's unset: tests, local dev, previews.
    "POSTHOG_TOKEN": "phc_nfEKbERy5wWGQWFzGbSArYPtRQnJrsYuDYzTLJmxFLd6",
    // On since the end-to-end tests passed (SPEC.md §3.12, STATUS.md).
    // "false" turns off /api/alerts/* and the seats cron's alert emails
    // (the app hides the bell); subscriptions stay in D1.
    "SEAT_ALERTS_ENABLED": "true",
    // Sign in with Google (docs/AUTH.md). It's on only with all of these
    // plus the secrets GOOGLE_CLIENT_SECRET and AUTH_SECRET; until then the
    // app hides sign-in and the start lands on /signin?error=unavailable.
    // "false" is the off switch. Admins are config/admins.txt, not a var.
    "SIGN_IN_ENABLED": "true",
    // The OAuth client's id (public).
    "GOOGLE_CLIENT_ID": "124652787090-o5hrmm196hl8hiamnu2elm2e7ab8f0re.apps.googleusercontent.com",
    // Where Google may send people back: <origin>/api/auth/google/callback
    // must be a registered redirect URI for each one.
    "GOOGLE_REDIRECT_ORIGINS": "https://terpsicle.com",
    // Moderation model calls per UTC day, at most (Workers AI cost). Past it,
    // new reviews and chat messages wait for the owner (docs/MODERATION.md).
    "MODERATION_DAILY_CAP": "2000",
    // Terpsicle Chat: "off" refuses sockets and chat/* routes, "read" lets
    // people read but not send, "on". On since the Chat UI (#91) shipped
    // (the owner, 2026-09-26: ship each product when its screens land).
    "CHAT_ENABLED": "on",
    // Terpsicle Reviews: off | read | on (docs/V2.md §7.4). "off" answers
    // every reviews/* route with "unavailable" except `reviews/page`, which
    // still serves PlanetTerp's for Schedule's preview; "read" lists,
    // deletes and reports but takes no new words. Off since Reviews moved to
    // PlanetTerp (the owner, 2026-10-05, "Reviews link out to PlanetTerp"):
    // no writing, no moderation, none of our numbers.
    "REVIEWS_ENABLED": "off",
    // REVIEWS_PAGES_ENABLED (our own /reviews pages) is unset here, so
    // they're off: their addresses answer a 302 to PlanetTerp's and the
    // purple tab opens planetterp.com. "true" brings them back, with
    // REVIEWS_ENABLED above; reverting this PR does both.
    // Terpsicle Todo (docs/V3.md §3). "on" also needs the secret
    // TODO_FEED_KEY (32 random bytes, base64url) on this Worker; without it
    // every /api/todo/* answers "unavailable". To rotate the key: set the new
    // one as TODO_FEED_KEY with a new TODO_FEED_KEY_ID, and the old one as
    // TODO_FEED_KEY_PREVIOUS with TODO_FEED_KEY_PREVIOUS_ID (a var); once no
    // row names the old id, remove both (docs/V3.md §3.3). On with the Todo
    // UI (#86); TODO_FEED_KEY is set.
    "TODO_ENABLED": "on",
    "TODO_FEED_KEY_ID": "k1",
    // Web push (docs/V2.md §6.4). On (owner, 2026-09-27); the real-device
    // check on an iPhone Home Screen app and Android Chrome happens live.
    // Needs the secret VAPID_PRIVATE_KEY, the pair of this public key
    // (rotating them breaks every subscription; scripts/vapid-keys.ts makes a
    // pair). Rotated when push went on, before any device had subscribed.
    "PUSH_ENABLED": "true",
    "VAPID_PUBLIC_KEY": "BMGNIVAOorJuiXhNqbpU70RPpPPUf39vJI_PaxT7-bADe07mHv5gj-Yb3COvqwVGZsj5vKsei6GVMWgLOuCwPS0",
    "VAPID_SUBJECT": "mailto:alerts@terpsicle.com",
    // Terpsicle Plan (docs/V3.md §2.4): "true" lets sync/push save four-year
    // docs; otherwise a push carrying one answers "unavailable". On with the
    // Plan UI (#98): tabs that skip unknown doc kinds shipped in #87, and the
    // Dexie v3 upgrade resets a device's pull cursor so nothing is missed.
    "PLAN_ENABLED": "true",
    // Synced data is sealed with a key per account, each wrapped by the
    // secret USER_DATA_KEY (32 random bytes, base64url) on this Worker
    // (docs/DATA.md §7.7). Without it sync, Chat's plan reads, the calendar
    // feed and own tasks answer "unavailable": there's no plain-text
    // fallback. To rotate: set the new key as USER_DATA_KEY with a new
    // USER_DATA_KEY_ID, and the old one as USER_DATA_KEY_PREVIOUS with
    // USER_DATA_KEY_PREVIOUS_ID (a var); once the daily job has rewrapped
    // every account's key (no `user_keys` row names the old id), remove both.
    // Previews and mock mode use test mode's fixed key instead.
    "USER_DATA_KEY_ID": "k1"
  },
  "ai": { "binding": "AI" },
  // Cloudflare Email Service; terpsicle.com is onboarded for sending.
  "send_email": [{ "name": "EMAIL" }],

  // Keep in sync with CRON_JOBS in src/jobs/index.ts (a worker test checks it).
  "triggers": {
    "crons": [
      "*/5 * * * *", // seats
      "0 */6 * * *", // catalog
      "41 */6 * * *", // history: who taught what, copied from the catalog
      "17 5 * * *", // planetterp
      "23 6 * * 1", // calendar + buildings
      "37 * * * *", // reviews-publish: Terpsicle reviews' numbers to R2
      "7 13 * * *", // daily: account purge, expired sessions, Todo pruning
      "3,23,43 * * * *" // todo feeds
      // Routes run from GitHub Actions (.github/workflows/routes.yml): a
      // Worker can't fetch UMD's routing token (maps.umd.edu answers 526).
    ]
  },

  // PR previews (`wrangler preview`). Crons never run on previews. They read
  // the production data bucket, which is only ever written by crons, and get
  // their own D1 database so preview code can't touch real subscriptions.
  // No send_email binding: previews must never email real people.
  // Previews don't inherit vars. They sign in with test mode, never Google
  // (Google allows no wildcard redirect URIs, and a real identity must never
  // reach unreviewed PR code): /auth/test lists the TEST_USERS fixtures,
  // and tadmin is the admin. The Worker refuses test mode on terpsicle.com
  // whatever the vars say (docs/AUTH.md, "Test mode").
  // Chat is on in previews. Bound without `script_name`, each preview's
  // COURSE_CHAT is its own namespace, so previews never share rooms with
  // each other or with production (checked for v2/chat-do; STATUS.md).
  "previews": {
    // Each preview caches apart from production.
    "cache": { "enabled": true },
    // Todo on previews runs in test mode: a fixed key and the fixture feed,
    // never TODO_FEED_KEY or a real ELMS link.
    "vars": {
      "AUTH_TEST_MODE": "true",
      "CHAT_ENABLED": "on",
      "REVIEWS_ENABLED": "on",
      // REVIEWS_PAGES_ENABLED stays unset: previews show Reviews as
      // production will, linking out to PlanetTerp. Mock mode turns it on.
      "TODO_ENABLED": "on",
      // Previews never push: their test-mode key reaches no real device.
      "PUSH_ENABLED": "false",
      "PLAN_ENABLED": "true"
    },
    "durable_objects": {
      "bindings": [{ "name": "COURSE_CHAT", "class_name": "CourseChat" }]
    },
    "r2_buckets": [
      { "binding": "DATA", "bucket_name": "terpsicle-data" },
      {
        "binding": "USER_CONTENT",
        "bucket_name": "terpsicle-user-content-preview"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "terpsicle-preview",
        "database_id": "b1a4458a-e0ae-4ce5-b410-46bc2130db8c",
        "migrations_dir": "migrations"
      }
    ],
    "ai": { "binding": "AI" }
  }
}
